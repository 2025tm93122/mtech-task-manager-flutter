# Parse-compatible backend configuration.
# Works with Railway Parse Server now and Back4App later.
#
# IMPORTANT:
# - Keep the real .back4app.env private.
# - Do NOT put PARSE_SERVER_MASTER_KEY or MongoDB credentials here.
# - Do NOT commit .back4app.env to Git.

PARSE_APP_ID="YOUR_PARSE_APPLICATION_ID"

# Railway Parse Server normally does not require a client key.
# Back4App can use this later if required.
PARSE_CLIENT_KEY=""

# Use the PUBLIC Parse Server URL.
# Example:
# PARSE_SERVER_URL="https://parse-production-xxxxx.up.railway.app/parse"
PARSE_SERVER_URL="https://YOUR-PARSE-DOMAIN/parse"

# Leave blank until Live Query is configured and verified.
PARSE_LIVE_QUERY_URL=""

# Optional.
# Set this to your university email domain if you want to restrict registration.
# Example: wilp.bits-pilani.ac.in
STUDENT_EMAIL_DOMAIN=""
